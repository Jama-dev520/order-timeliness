# 区域：us / uk / au / all（all = 后台右上角 All tab，即 UK + US 合并抓取）
OC_REGION=us
OC_COOKIE=hk-sit=你的登录Cookie（浏览器 F12 → Application → Cookies → hk-sit）
OC_DAYS=14
# 固定起始日：设置后看板与清单都从这天抓至今，忽略 OC_DAYS；留空则按 OC_DAYS 滚动
# ⚠️ 后台对 startDate 有硬下限（约「今天往前 17 天」）。写更早的日期不会报错，
#    而是静默忽略时间条件返回全库（US 约 2.5 万单）——scraper 有守卫会直接报错。
OC_START_DATE=2026/10/19

# 两条看板口径（不填则默认 2026/10/29 与 2026/10/22）
# 汇总：KPI 与所有图表只算这天起的单；明细：底部订单明细能查到这天起的单
OC_KPI_START=2026/10/29
OC_DETAIL_START=2026/10/19

# 静态看板内嵌「原始事件」的窗口（天）。默认 7：最近 7 天建单的单 + 所有还没妥投的真实单。
# 调大 = 抽屉能看更多单的原始事件，代价是 dashboard.html 变大（全量约 2.5MB，7 天约 1.5MB）。
# 0 = 不裁，全部内嵌。
# OC_RAW_DAYS=7

# 自动续登录（login_browser.py 用）。填了这两项，重登时浏览器会自动填账号密码，
# 你只需要看一眼 4 位验证码。不填也能用，只是每次都要手输账号。
# OC_USER=你的域账号
# OC_PASS=密码

# 可选
# OC_DEST_COUNTRY=US        # 强制目的国；留空则按区域默认（US 带 US，UK 不筛）
# OC_DASHBOARD_TOKEN=xxx    # 看板访问口令；设置后进入只读模式，未登录无法访问（内部：全量视图）
# OC_DASHBOARD_TOKEN_EXT=xxx  # 外发口令：公司同事用。收件人打码、门牌地址不返回。
# OC_RDC_EVENT=DFDLUS002    # 覆盖出库码
# OC_SPX_EVENT=SCAUS002     # 覆盖 SPX 提取主码
# OC_SPX_EVENT_EXTRA=SCN005 # SPX 提取的补充码，任一命中即算；逗号分隔，留空则只认主码
# OC_LABEL_EVENT=OCRETURNLBDE002   # 覆盖面单生成码
# OC_DELIVERED_EVENT=DELUS006,DEL005   # 覆盖妥投码（逗号分隔，两个都认）
# OC_API_PREFIX=/aquarius-order
# OC_BASE_URL=https://spk-hub-us-api.orangeconnex.com   # 仅单区域调试用

# ---- tunnel_keeper.py 的数据守护（cookie 体检 + 定时刷新 + 失效弹浏览器）----
# 不用人每天手动跑 login_browser.py / refresh_all.py。OC_KEEPER_DATA=0 可整体关掉。
# OC_KEEPER_DATA=1
# OC_COOKIE_TICK=1800        # 多久验一次 hk-sit（秒），只打一次列表接口
# OC_REFRESH_MAX_AGE=3600    # 数据旧于这个秒数就自动跑 refresh_all.py
# OC_LOGIN_COOLDOWN=1800     # 续期失败后多久内不重复弹登录窗（秒）
# OC_LOGIN_TIMEOUT=900       # 登录窗最多等多久（秒）
# OC_REFRESH_TIMEOUT=1200    # 单次刷新最多跑多久（秒），超时终止
