# 凭证与登录态：绝不入库
.env
.env.local
.env.*.local
data/_auth_state.json
.cdp-profile/
.pw-profile/

# 运行产物
data/*.csv
data/*.json
data/*.xlsx
!data/.gitkeep
logs/
__pycache__/
*.pyc
bin/
*.log
dashboard.html
# 本地生成的报表/临时页（根目录与 data/ 下的 html 都不入库）
*.html
_data_tmp/

# 测试截图
data/_*.png

# 发布产物：由 Actions 每次现场 build（build_site.py --out site），不入库。
# 仓库里留着旧的 data.bin 只会让 clone 变大，而且口令一换旧密文就是垃圾。
site/

