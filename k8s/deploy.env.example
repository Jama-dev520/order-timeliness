# 私有 K8S 部署参数 —— 复制成 deploy.env 后填值，再跑 python k8s/render.py
#
# 必填
IMAGE=harbor.example.com/infra/oc-timeliness:1.0.0
HOST=oc-timeliness.example.com

# 可选（留空 = 用集群默认）
INGRESS_CLASS=nginx
STORAGE_CLASS=
# 已有 TLS secret 就填名字；留空 = 不配 tls 段（纯 HTTP，内网可用）
TLS_SECRET=
# 集群装了 cert-manager 就填 issuer 名，自动签发并续期证书；留空 = 不加注解
CLUSTER_ISSUER=
